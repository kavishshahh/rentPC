# SITE_ADDRESS is ":80" for plain-IP access, or "rentpc.example.com" for
# automatic HTTPS once a domain points at the instance.
{$SITE_ADDRESS}

encode gzip

# Rentals go through the payment gateway when enabled (RENT_UPSTREAM=paygate:8090).
@rent {
	path /v1/rentals
	method POST
}
handle @rent {
	reverse_proxy {$RENT_UPSTREAM}
}

@api path /v1/* /healthz
handle @api {
	reverse_proxy api:8080
}

handle {
	reverse_proxy web:3000
}
