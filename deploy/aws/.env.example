# --- MPP / Tempo payment gateway (optional; docker compose --profile mpp) ---
PAYGATE_SECRET=        # openssl rand -hex 32  (shared by api + paygate)
MPP_SECRET_KEY=        # openssl rand -hex 32  (signs MPP challenges)
MPP_RECIPIENT=         # 0x... Tempo address that receives rental payments (marketplace treasury)
MPP_REALM=rentpc
TEMPO_RPC_URL=https://rpc.moderato.tempo.xyz
RENT_UPSTREAM=paygate:8090
