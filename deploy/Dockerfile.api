# Build from the repo root: docker build -f deploy/Dockerfile.api .
FROM golang:1.24-alpine AS build
WORKDIR /src
ENV GOWORK=off
COPY packages/protocol ./packages/protocol
COPY apps/api ./apps/api
RUN cd apps/api && go mod download && CGO_ENABLED=0 go build -o /out/api ./cmd/api

FROM alpine:3.20
RUN adduser -D -u 10001 app
USER app
COPY --from=build /out/api /usr/local/bin/api
EXPOSE 8080
ENV PORT=8080
CMD ["api"]
